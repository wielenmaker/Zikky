+    item.msgSend(void, "setTag:", .{@as(c_long, @intFromEnum(it.code))});
+    return item;
+}
+
+fn string(s: [:0]const u8) objc.Object {
+    return objc.getClass("NSString").?.msgSend(objc.Object, "stringWithUTF8String:", .{s.ptr});
+}
